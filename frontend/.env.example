# 默认保持本机 IndexedDB 模式，不会发起任何网络同步。
VITE_SYNC_PROVIDER=local
VITE_SYNC_AUTO=true

# 本地 PostgreSQL Compose 默认连接串，仅供服务端使用，不要放入 VITE_ 变量。
SHOPEERS_DATABASE_URL=postgres://shopeers:shopeers-dev-only@127.0.0.1:55432/shopeers
SHOPEERS_SYNC_BACKEND=memory
SHOPEERS_SYNC_CORS_ORIGINS=http://127.0.0.1:5173
SHOPEERS_DB_POOL_MAX=10
SHOPEERS_DATABASE_SSL=
SHOPEERS_JWKS_URL=
SHOPEERS_JWT_ISSUER=
SHOPEERS_JWT_AUDIENCE=authenticated

# 使用独立 API 时填写；不要把服务端密钥放在 VITE_ 变量中。
VITE_API_BASE_URL=

# Supabase 项目地址只用于 Auth/项目识别；同步接口必须是已部署的 Edge Function 或独立 API 地址。
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SYNC_API_BASE_URL=

# 可选：本机 ERP Assistant 成本收件服务；不填写时仍可使用页面消息和手动导入。

# 仅开发同步服务使用；生产环境应由 JWT 与数据库成员表决定角色。
SHOPEERS_SYNC_TOKEN=
SHOPEERS_SYNC_ROLE=admin
SHOPEERS_SYNC_WORKSPACES=
