FROM node:22-bookworm-slim

WORKDIR /app
ENV NODE_ENV=production

RUN corepack enable

# Install only the server-side dependencies declared by the frontend workspace.
COPY frontend/package.json frontend/pnpm-lock.yaml /app/frontend/
RUN cd /app/frontend && pnpm install --prod --frozen-lockfile

# The production API imports the audited domain contracts and PostgreSQL adapters.
COPY frontend/src /app/frontend/src
COPY frontend/supabase /app/frontend/supabase
COPY tools/sync-production-server.mjs /app/tools/sync-production-server.mjs

EXPOSE 8787
CMD ["node", "/app/tools/sync-production-server.mjs"]

